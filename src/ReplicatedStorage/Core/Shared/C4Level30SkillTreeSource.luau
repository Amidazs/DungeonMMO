--[[
Copies one tuple to named source fields for safer audit consumers.

Args:
    row (any): Immutable compact row tuple.

Returns:
    any: Named, independently editable source learning row.
]]
local function expand(row: any): any
    return {
        SkillId = row[1],
        SkillLevel = row[2],
        SkillName = row[3],
        SP = row[4],
        MinLevel = row[5],
        Origin = row[6],
    }
end

--[[
Returns exact learning rows for one current original C4 path.

Args:
    scope_id (string): Starter or implemented first-transfer scope ID.

Returns:
    any?: Source class metadata plus copied level<=30 learning rows.
]]
function C4Level30SkillTreeSource.get(scope_id: string): any?
    local source = CLASSES[scope_id]
    if not source then return nil end
    local rows = {}
    for _, row in ipairs(source.Rows) do
        table.insert(rows, expand(row))
    end
    return {
        ScopeId = source.ScopeId,
        RaceId = source.RaceId,
        ClassId = source.ClassId,
        SourceClassId = source.SourceClassId,
        Rows = rows,
    }
end

--[[
Finds exact learning rows for one source skill within a source class.

Args:
    scope_id (string): One currently tracked original source scope.
    skill_id (number): Historical C4 skill ID.

Returns:
    {any}: Ordered source levels through character level 30.
]]
function C4Level30SkillTreeSource.find_skill(
    scope_id: string, skill_id: number
): {any}
    local source = CLASSES[scope_id]
    local rows = {}
    if not source then return rows end
    for _, row in ipairs(source.Rows) do
        if row[1] == skill_id then
            table.insert(rows, expand(row))
        end
    end
    return rows
end

--[[
Reports whole-current-original-class learning-tree coverage.

Args:
    None.

Returns:
    any: Tracked paths, exact row count and source provenance.
]]
function C4Level30SkillTreeSource.coverage(): any
    local scopes = {}
    local total_rows = 0
    local skills = {}
    for _, scope_id in ipairs({
        "HumanFighter", "HumanMystic", "HumanWizard",
        "HumanCleric", "ElvenFighter", "ElvenMystic",
        "HumanWarrior", "HumanKnight", "HumanRogue",
        "ElvenKnight", "ElvenScout",
    }) do
        local source = assert(CLASSES[scope_id])
        total_rows += #source.Rows
        for _, row in ipairs(source.Rows) do
            skills[row[1]] = true
        end
        table.insert(scopes, {
            ScopeId = scope_id,
            SourceClassId = source.SourceClassId,
            RowCount = #source.Rows,
        })
    end
    local unique_skills = 0
    for _ in pairs(skills) do unique_skills += 1 end
    return {
        PathCount = #scopes,
        RowCount = total_rows,
        UniqueSourceSkillIds = unique_skills,
        LevelCap = 30,
        SourceCommit = SOURCE_COMMIT,
        SkillTreeUrl = SOURCE_TREE_URL,
        AutomaticCommonSourceUrl = L2HUB_COMMON_URL,
        ExpertiseSourceUrl = L2HUB_EXPERTISE_URL,
        Scopes = scopes,
        LiveTrainerIntegrated = false,
    }
end

return table.freeze(C4Level30SkillTreeSource)
