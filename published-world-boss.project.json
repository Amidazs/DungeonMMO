{
  "name": "DungeonMMO_WorldBoss_Published",
  "globIgnorePaths": [
    "**/Tests/**",
    "**/ArenaBuilder.server.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Core": {
        "$path": "src/ReplicatedStorage/Core"
      },
      "Combat": {
        "$path": "src/ReplicatedStorage/Combat"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Core": {
        "$path": "src/ServerScriptService/Core"
      },
      "Combat": {
        "$path": "src/ServerScriptService/Combat"
      },
      "Dungeon": {
        "$className": "Folder",
        "MarauderCaptainFactory": {
          "$path": "src/ServerScriptService/Dungeon/MarauderCaptainFactory.luau"
        },
        "DungeonWeeklyWorldBossFactory": {
          "$path": "src/ServerScriptService/Dungeon/DungeonWeeklyWorldBossFactory.luau"
        },
        "DungeonContributionBridge": {
          "$path": "src/ServerScriptService/Dungeon/DungeonContributionBridge.luau"
        },
        "DungeonProgressionBridge": {
          "$path": "src/ServerScriptService/Dungeon/DungeonProgressionBridge.luau"
        },
        "MarauderCaptainController": {
          "$path": "src/ServerScriptService/Dungeon/MarauderCaptainController.server.luau"
        }
      },
      "WorldBoss": {
        "$path": "src/ServerScriptService/WorldBoss"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Core": {
          "$path": "src/StarterPlayerScripts/Core"
        },
        "Combat": {
          "$path": "src/StarterPlayerScripts/Combat"
        }
      },
      "$properties": {
        "EnableMouseLockOption": false
      }
    }
  }
}
