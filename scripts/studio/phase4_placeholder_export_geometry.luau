--!strict
-- Exports ACTUAL geometry generated by the source modules into Studio output.
-- The paired offline converter creates an editable .rbxlx preview from records.
-- Runs only in Edit mode on an unpublished TEMP local project.
assert(game.PlaceId == 0 and game.GameId == 0,
    "Placeholder export must never run in a published place.")
local W = game:GetService("Workspace")
local SSS = game:GetService("ServerScriptService")
local HTTP = game:GetService("HttpService")
local Tags = game:GetService("CollectionService")
local Dungeon = SSS:WaitForChild("Dungeon")
local Builder = require(Dungeon:WaitForChild(
    "DungeonPlaceholderPhysicalContent"))
local scenes = Instance.new("Folder")
scenes.Name = "DungeonMMO_PlaceholderPreviewScenes"
scenes.Parent = W

local count = 0
local function walk(instance: Instance, path: string)
    if not instance:IsA("Folder") and not instance:IsA("Model")
        and not instance:IsA("BasePart")
    then
        error("Unknown placeholder export class: " .. instance.ClassName)
    end
    local record = {
        Path = path,
        ClassName = instance.ClassName,
        Attributes = instance:GetAttributes(),
        Tags = Tags:GetTags(instance),
    }
    if instance:IsA("BasePart") then
        local r = {instance.CFrame:GetComponents()}
        record.PositionRotation = r
        record.Size = {
            instance.Size.X, instance.Size.Y, instance.Size.Z,
        }
        record.Color = {
            instance.Color.R, instance.Color.G, instance.Color.B,
        }
        record.Material = instance.Material.Value
        record.Transparency = instance.Transparency
        record.Anchored = instance.Anchored
        record.CanCollide = instance.CanCollide
        record.CanTouch = instance.CanTouch
        record.CanQuery = instance.CanQuery
        record.CastShadow = instance.CastShadow
    end
    print("[Phase4 Geometry Export] RECORD " .. HTTP:JSONEncode(record))
    count += 1
    for _, child in ipairs(instance:GetChildren()) do
        walk(child, path .. "/" .. child.Name)
    end
end

for _, item in ipairs({
    {"TestDungeon", "TempleSyntheticEnvironment"},
    {"AbandonedMine", "AbandonedMineSyntheticEnvironment"},
}) do
    local id, source = item[1], item[2]
    local scene = Instance.new("Folder")
    scene.Name = id
    scene.Parent = scenes
    require(Dungeon:WaitForChild(source)).create(scene)
    Builder.create(scene, id)
    walk(scene, id)
end
print("[Phase4 Geometry Export] PASS "..count.." records from source geometry")
